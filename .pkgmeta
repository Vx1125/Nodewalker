package-as: Nodewalker

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - README.md
  - .github
  - VERSION
  - CURSEFORGE.md
  - DEVELOPMENT.md
  - MARKETING.md
  - UI_DESIGN_STANDARD.md
  - screenshots
  - tools
  - research
  - CLAUDE.md
  - CLAUDE.local.md
  - .claude
  - .gitignore
  - .pkgmeta
