<Bindings>
  <Binding name="NODEWALKER_TOGGLE" header="NODEWALKER" category="ADDONS">
    Nodewalker.ToggleOverlay()
  </Binding>
  <Binding name="NODEWALKER_PLANNER" category="ADDONS">
    Nodewalker.TogglePlanner()
  </Binding>
  <Binding name="NODEWALKER_NEXT" category="ADDONS">
    Nodewalker.SkipNext()
  </Binding>
  <Binding name="CLICK NodewalkerSmartFish:LeftButton" category="ADDONS">
  </Binding>
  <Binding name="NODEWALKER_FISHHUD" category="ADDONS">
    Nodewalker.ToggleFishHUD()
  </Binding>
  <Binding name="NODEWALKER_JOURNAL" category="ADDONS">
    Nodewalker.OpenFishJournal()
  </Binding>
</Bindings>
